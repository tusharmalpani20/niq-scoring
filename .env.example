# NIQ SCORING PLATFORM — ENVIRONMENT REFERENCE
#
# Copy this file to `.env` for local development. Never commit `.env`.
# Values shown below are development examples, not production credentials.
# Generate every secret independently, for example: openssl rand -hex 32

# Runtime environment.
# Values: development | test | production
# Default: development
NODE_ENV=development

# Scoring API TCP port.
# Values: integer from 1 to 65535
# Default: 4100
PORT=4100

# PostgreSQL connection used only by the scoring platform.
# Required; there is no default. Use a separate database from the main application.
# Replace the example password and URL-encode special characters in credentials.
DATABASE_URL=postgresql://niq:replace-database-password@localhost:5432/niq_scoring

# Minimum log severity:
# - debug: detailed diagnostics; local troubleshooting only.
# - info: normal lifecycle and request events; recommended default.
# - warn: unexpected/recoverable conditions plus errors.
# - error: failures only.
# Values: debug | info | warn | error
# Default: info
# Logs must never contain credentials, activation tokens, or patient health data.
LOG_LEVEL=info

# Browser origins permitted to call the scoring API, separated by commas.
# Use exact origins (scheme, host and port), without paths or trailing slashes.
# Default: http://localhost:4173
CORS_ALLOWED_ORIGINS=http://localhost:4173

# Region in which this scoring-platform deployment operates.
# This is deployment metadata and must agree with infrastructure/data-residency
# policy; changing the text alone does not move or isolate data.
# Common values: india | us | eu
# Default: india
DEPLOYMENT_REGION=india

# One-time first NIQ admin setup secret (minimum 32 characters).
# Works in every environment; setup permanently closes once an admin exists.
# Remove after setup. Never share with customer applications or use as API auth.
ADMIN_BOOTSTRAP_TOKEN=replace-with-an-independent-random-token-at-least-32-characters

# Global emergency switch for scoring across every customer and deployment.
# false blocks new scoring even if all customer-level entitlements are enabled.
# Values: true | false
# Default: true
SCORING_PLATFORM_ENABLED=true

# Face-scan integration adapter:
# - stub: placeholder adapter; it never calls a real face-scan provider and fails
#   closed. Use it while integrating local workflows or when face scan is absent.
# - careplix: CarePlix integration boundary; requires provider configuration and
#   validation before production use.
# Values: stub | careplix
# Default: stub
FACE_SCAN_PROVIDER=stub

# Secret reserved for authenticating face-scan webhook requests.
# Required even with the stub adapter; minimum 24 characters; no default.
# Generate independently and never reuse a deployment or administration token.
FACE_SCAN_WEBHOOK_SECRET=replace-with-an-independent-random-secret-at-least-24-characters

# Enable the temporary, non-clinically-validated draft scoring engine.
# Values: true | false
# Default: false
# Development/test only. Production always disables draft scoring regardless of
# this value. Draft results must never be used for patient-care decisions.
ENABLE_PROVISIONAL_SCORING=false

# IMPORTANT — customer and deployment credentials are not environment variables.
# An NIQ operator creates a customer, organization and deployment through the
# scoring administration workflow, then issues a short-lived, one-time activation
# token. The client application exchanges that token server-to-server. The
# deployment credential is returned exactly once, while this platform stores only
# a hash. Per-customer limits, enabled/disabled state and assigned scoring version
# live in PostgreSQL and are managed centrally, not copied into every `.env`.
#
# Current implementation status:
# - The scoring API supports provisioning and one-time activation.
# - The administration UI supports core customer/deployment management.
# - NIQ staff use individual administrator accounts and one-time invitations.
# - Deployment activation-token generation and the main application's activation
#   screen/encrypted credential store are implemented. Assessment submission is
#   separate work and is not enabled by activation alone.

# 32 random bytes encoded as 64 hex characters; keep stable and outside the database.
# Required for deployment creation and recoverable activation tokens.
ACTIVATION_TOKEN_ENCRYPTION_KEY=
