NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://niq_scoring:change-me@localhost:5433/niq_scoring
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4173
DEPLOYMENT_REGION=india
# Development only. Production credentials must be issued, hashed, rotated and never committed.
DEV_API_KEY=replace-with-a-long-random-value
FACE_SCAN_PROVIDER=stub
FACE_SCAN_WEBHOOK_SECRET=replace-with-a-long-random-value
# Development/test only. Production ignores this flag and always disables draft scoring.
ENABLE_PROVISIONAL_SCORING=false
