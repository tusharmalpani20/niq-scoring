# Copy outside the checkout to a private file, chmod 600, replace placeholders.
# Pass the same absolute path to --env-file and NIQ_SCORING_ENV_FILE.
NODE_ENV=development
NIQ_SCORING_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
PORT=4100
DEPLOYMENT_REGION=india
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://scoring-staging.example.com
SCORING_PLATFORM_ENABLED=true
ENABLE_PROVISIONAL_SCORING=false
REPORT_AI_PROVIDER=openrouter
REPORT_AI_PROVIDER_ENABLED=true
OPENROUTER_API_KEY=
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACTIVATION_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
FACE_SCAN_ENABLED=false
FACE_SCAN_PROVIDER=stub
CAREPLIX_CONTRACT_CONFIRMED=false
FACE_SCAN_WEBHOOK_BEARER_CONFIRMED=false
